<%-
  # OOD exposes the compute-node host/port via `connect.host` and `connect.port`
  # (read from connection.yml). Guard against either being missing so we never
  # redirect to a bad URL that would land the browser on Apache's default page.
  host = connect.host rescue nil
  port = connect.port rescue nil
  next_url = (host && port) ? "/rnode/#{host}/#{port}/" : nil
-%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <% if next_url %>
  <meta http-equiv="refresh" content="0; URL='<%= next_url %>'" />
  <% end %>
  <title>RELION 5 Web UI</title>
</head>
<body>
  <% if next_url %>
    <p>Opening RELION 5 Web UI at <code><%= host %>:<%= port %></code>…</p>
    <p>If nothing happens, <a href="<%= next_url %>">click here</a>.</p>
  <% else %>
    <p><strong>Session started but no connection URL is available.</strong></p>
    <p>The compute node did not report its port. Check
    <code>connection.yml</code> in the session's output directory. See
    <a href="/pun/sys/dashboard/batch_connect/sessions">My Interactive Sessions</a>.</p>
  <% end %>
</body>
</html>
