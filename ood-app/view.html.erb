<%-
  host = connect.host rescue nil
  port = connect.port rescue nil
-%>
<% if host && port %>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">RELION 5 Web UI</h5>
      <p class="text-muted small">
        Session running on <code><%= host %>:<%= port %></code>
      </p>
      <a href="/rnode/<%= host %>/<%= port %>/" class="btn btn-primary" target="_blank" rel="noopener">
        <i class="fa fa-external-link"></i> Open RELION 5 Web UI
      </a>
      <p class="text-muted small mt-2">
        Opens in a new tab. Close the tab or delete this session
        (in Interactive Sessions) to end it.
      </p>
    </div>
  </div>
<% else %>
  <div class="alert alert-warning">
    Session started but no connection URL is available yet — waiting for
    the compute node to report its port. Check
    <code>connection.yml</code> in the session's output directory. See
    <a href="/pun/sys/dashboard/batch_connect/sessions">My Interactive Sessions</a>.
  </div>
<% end %>
