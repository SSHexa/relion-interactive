# Example env file for the RELION 5 OOD Interactive App.
#
# Copy this to /etc/ood/config/apps/relion5_webui/env and edit for your
# site. OOD sources it before running form.yml / submit.yml.erb /
# template/script.sh.erb.
#
# ALL VALUES BELOW ARE EXAMPLES — most sites need to change at least the
# ones marked (REQUIRED).

# --- OOD cluster binding -------------------------------------------------
# The id of the file under /etc/ood/config/clusters.d/<id>.yml this app
# submits jobs to. Must exist on the OOD host.
RELION_CLUSTER=slurm

# --- Slurm defaults for the Interactive App job itself -------------------
# Only affects the job that hosts the web UI, NOT the RELION jobs the UI
# submits (those get their own partition per RELION_PARTITION below).
RELION_PARTITION=compute
RELION_MEM_PER_JOB=12G

# --- Backend/frontend install locations on compute nodes (REQUIRED) ------
# The compute node must be able to read these paths. On most clusters
# they live on a shared filesystem like /home, /shared, /scratch, /apps.
RELION_BACKEND_DIR=/opt/relion5/backend
RELION_FRONTEND_DIR=/opt/relion5/frontend

# --- RELION container (REQUIRED) -----------------------------------------
# Path to a Singularity/Apptainer image containing RELION binaries at
# /usr/local/bin. Pre-built images are published by the RELION community;
# see docs/DEPLOYMENT.md for build instructions.
RELION_CONTAINER=/opt/relion5/relion.sif

# ctffind path INSIDE the container. Most RELION containers ship it at
# /opt/ctffind/bin/ctffind. Override if yours is different.
RELION_CTFFIND_IN_CONTAINER=/opt/ctffind/bin/ctffind

# --- Container bind mounts -----------------------------------------------
# Comma-separated list of HOST_PATH:CONTAINER_PATH pairs. Everything the
# RELION jobs need to read/write must be bound in. Typical sites bind
# their shared filesystem where user projects live.
#
# Example single-FS: /home:/home
# Example multi:     /home:/home,/scratch:/scratch,/data:/data
RELION_CONTAINER_BIND=/home:/home

# --- User project directory default --------------------------------------
# Shown as the default in the "Project Directory" form field. Users can
# type anything else. `${HOME}` and `${USER}` are NOT expanded here — use
# a literal path, or leave unset to default to $HOME/relion_projects.
# RELION_DEFAULT_PROJECTS_DIR=/scratch/relion_projects

# --- Advanced: cluster mode ----------------------------------------------
# Almost every site should leave this as 'generic'. Only
# Azure CycleCloud-style deployments with a dual-filesystem setup (OOD
# and compute nodes see different /shared) need 'cyclecloud'. See
# docs/CYCLECLOUD.md.
RELION_CLUSTER_MODE=generic

# --- Optional: hide sample/tutorial projects from the UI ----------------
# Comma-separated names (matched against directory basenames).
# RELION_HIDDEN_PROJECTS=relion30_tutorial,demo,E2E_Test
