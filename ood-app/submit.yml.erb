---
batch_connect:
  template: "basic"
script:
  native:
    - "-p"
    - "<%= bc_queue %>"
    - "-c"
    - "<%= bc_num_slots.to_i %>"
    - "-t"
    - "<%= bc_num_hours.to_i %>:00:00"
    - "--mem"
    - "<%= bc_memory %>"
    - "-J"
    # Static job name — OOD's auto-generated name is "sys/dashboard/sys/<app>"
    # which contains "/" characters that Slurm rejects.
    - "relion5-webui"
